{
  "name": "boda-tachi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Invitación digital de Sofía e Isaac · 22 de mayo de 2027",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "db:backup": "tsx server/scripts/backup.ts",
    "db:restore": "tsx server/scripts/restore.ts",
    "demo:seed": "tsx server/scripts/demo.ts seed",
    "demo:clear": "tsx server/scripts/demo.ts clear",
    "admin:hash": "tsx server/scripts/hash-password.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@playwright/test": "1.56",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
