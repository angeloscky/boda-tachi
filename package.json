{
  "name": "boda-tachi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Invitación digital de Sofía e Isaac · 22 de mayo de 2027",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --import tsx --watch server/index.ts --rsvp-backend=demo",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:static": "vite build --mode static",
    "start": "node --disable-warning=ExperimentalWarning dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "node --disable-warning=ExperimentalWarning node_modules/vitest/vitest.mjs run",
    "test:e2e": "playwright test",
    "db:migrate": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/migrate.ts",
    "db:backup": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/backup.ts",
    "db:restore": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/restore.ts",
    "demo:seed": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/demo.ts seed",
    "demo:clear": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/demo.ts clear",
    "admin:hash": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/hash-password.ts",
    "logo:vectorize": "python3 scripts/vectorize-logo.py",
    "logo:assets": "node scripts/build-brand-assets.mjs",
    "sheets:build": "node --disable-warning=ExperimentalWarning --import tsx scripts/build-apps-script.ts",
    "demo": "npm run build && node --disable-warning=ExperimentalWarning dist/server/server/index.js --rsvp-backend=demo"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@playwright/test": "1.56",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
