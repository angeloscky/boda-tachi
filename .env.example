# Copia este archivo a .env y completa los valores. .env nunca se sube al repositorio.
PORT=3000
# URL pública con la que se comparten los enlaces (sin "/" final).
PUBLIC_BASE_URL=http://localhost:3000
# Ruta del archivo SQLite. Debe quedar fuera de dist/ y public/.
DB_PATH=./data/boda.sqlite
# Hash de la contraseña del panel. Genéralo con: npm run admin:hash
ADMIN_PASSWORD_HASH=
# Solo para desarrollo local: contraseña en texto plano si no hay hash.
# ADMIN_PASSWORD=
# Proveedor de mensajes. Por ahora solo "simulation" (no envía nada).
MESSAGING_PROVIDER=simulation
