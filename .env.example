# Copia este archivo a .env y completa los valores. .env nunca se sube al repositorio.
PORT=3000
# HOST=0.0.0.0   interfaz donde escuchar (en Render, 0.0.0.0; vacío = todas)
# URL pública de la invitación general (sin "/" final). Es la única que comparte el botón
# "Compartir invitación general" y la base de los enlaces personales.
PUBLIC_BASE_URL=http://localhost:3000

# Dónde se guardan las confirmaciones:
#   (vacío)  sin registro: la confirmación aparece como "todavía no habilitada". Nunca cae a la demo.
#   demo     demostración local con familias ficticias (SQLite en DB_PATH). No es producción.
#   sheets   Google Sheets mediante Apps Script (preparado; conexión pendiente). Ver google-sheets/README.md.
RSVP_BACKEND=

# Solo para RSVP_BACKEND=demo: base local de demostración (fuera de dist/ y public/).
DB_PATH=./data/demo.sqlite
# DEMO_SEED=0  evita crear las familias ficticias al arrancar.

# Solo para RSVP_BACKEND=sheets. El secreto vive en el servidor y en las propiedades del
# script; nunca en el navegador. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SHEETS_WEBAPP_URL=
SHEETS_SHARED_SECRET=
# SHEETS_TIMEOUT_MS=15000

# Hash de la contraseña del panel. Genéralo con: npm run admin:hash
ADMIN_PASSWORD_HASH=
# Solo para desarrollo local: contraseña en texto plano si no hay hash.
# ADMIN_PASSWORD=
# Número de proxies delante del servidor (0 si se expone directo).
# TRUST_PROXY=1
# Proveedor de mensajes. Por ahora solo "simulation" (no envía nada).
MESSAGING_PROVIDER=simulation
